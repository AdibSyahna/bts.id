# copy to .env and adjust as needed
NODE_ENV=development
PORT=3000

# path to the sqlite database file (relative to the project root)
# use ":memory:" for an ephemeral in-memory database
DB_FILE=data/app.db

# Secret used to sign access tokens (HS256). REQUIRED in production.
# generate one: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Access token lifetime: plain seconds or a duration such as 30m, 12h, 7d.
JWT_EXPIRES_IN=1h

# Refresh token lifetime: same syntax. Use 0 or "none" for a token that never
# expires (it then stays valid until the user changes their password).
JWT_REFRESH_EXPIRES_IN=30d
